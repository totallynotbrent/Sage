# Local Brot/OpenAI-compatible endpoint configuration
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
BROT_BASE_URL=http://127.0.0.1:8877/v1
BROT_API_KEY=replace-with-your-local-key
BROT_MODEL=deepseek/deepseek-v4-pro

# Optional overrides (defaults shown)
# HOST=0.0.0.0
# PORT=8000
# DATA_DIR=./data
# MAX_UPLOAD_MB=30
# MAX_TOTAL_MB=500
# CHUNK_CHARS=1500
# CHUNK_OVERLAP=200
# CONTEXT_CHUNK_BUDGET=8
