# OpenAI-compatible endpoint (self-hosted Ollama or cloud) — https://ollama.com/v1
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
API_URL=https://ollama.com/v1
API_KEY=replace-with-your-local-key
MODEL=gemma4:31b-cloud

# Optional overrides (defaults shown)
# SEARXNG_URL=http://192.168.1.57:8080/
# HOST=0.0.0.0
# PORT=8000
# DATA_DIR=./data
# MAX_UPLOAD_MB=30
# MAX_TOTAL_MB=500
# CHUNK_CHARS=1500
# CHUNK_OVERLAP=200
# CONTEXT_CHUNK_BUDGET=8
# SAGE_WATCH_DIRS=["/home/brent/notes/calculus", "/home/brent/notes/algebra"]
# SAGE_WATCH_SCAN_SECONDS=300