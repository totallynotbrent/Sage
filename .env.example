# Sage. OpenAI-compatible endpoint. Defaults target a local Ollama container
# reachable on the compose network at hostname "ollama" :11434.
# Copy this file to `.env` and adjust for your setup. `.env` is gitignored.
API_URL=http://ollama:11434
API_KEY=local
MODEL=

# Optional overrides (defaults shown)
# SEARXNG_URL=http://192.168.1.57:8080/
# SAGE_PASSWORD=  # if set, the web app asks for this password before opening
# HOST=0.0.0.0
# PORT=8000
# DATA_DIR=./data
# MAX_UPLOAD_MB=30
# MAX_TOTAL_MB=500
# CHUNK_CHARS=1500
# CHUNK_OVERLAP=200
# CONTEXT_CHUNK_BUDGET=8
# OLLAMA_NUM_CTX=16384  # context window in tokens; lower = less VRAM on small GPUs
# SAGE_LIGHTWEIGHT=false  # true = slim small-model prompt + trimmed tool schemas
# SAGE_WATCH_DIRS=["/home/brent/notes/calculus", "/home/brent/notes/algebra"]
# SAGE_WATCH_SCAN_SECONDS=300